# Variables every deployed environment's encrypted file (staging.sops.env / prod.sops.env) holds
# (S-03-T03). Names only — values never appear in plain text in the repository.
# Create or edit:  infra/secrets/secrets.sh edit staging
DJANGO_SECRET_KEY=
# Previous key(s) during a rotation, comma-separated; empty otherwise (rotate-secret runbook).
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_PASSWORD=
# Field-encryption key ring (S-03-T04): JSON {"<key id>": "<base64 32 bytes>"} and the active id.
NUMO9_FIELD_ENCRYPTION_KEYS=
NUMO9_FIELD_ENCRYPTION_ACTIVE_KEY=
