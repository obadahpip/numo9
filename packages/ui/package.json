{
  "name": "@numo9/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Numo9 design system (A-10): tokens, Tailwind theme, components, Storybook",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./theme.css": "./src/styles/theme.css",
    "./tokens.json": "./tokens/tokens.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "contrast": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --quiet --output-dir storybook-static"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.19",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "storybook": "8.6.19",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
