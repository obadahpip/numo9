      },
      "subtle": {
        "$value": "{color.neutral.25}",
        "$description": "Side navigation, table header"
      },
      "muted": {
        "$value": "{color.neutral.50}",
        "$description": "Wells, hovered rows, read-only fields"
      },
      "inverse": {
        "$value": "{color.brand.black}",
