{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">Statement for {{ contact }}</mj-text>
        <mj-text padding="0 24px 12px">{% if kind == "activity" %}Your statement of activity from {{ period_start }} to {{ as_at }} is attached.{% else %}Your statement of outstanding items as at {{ as_at }} is attached.{% endif %}</mj-text>
        <mj-text font-size="16px" font-weight="700" padding="0 24px 12px">Amount due: {{ amount_due }}</mj-text>
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">Questions about this statement? Reply to this email.</mj-text>{% endblock %}
{% block footer %}{{ organisation }}{% endblock %}
