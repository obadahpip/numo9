{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">Relevé de {{ contact }}</mj-text>
        <mj-text padding="0 24px 12px">{% if kind == "activity" %}Vous trouverez ci-joint votre relevé des opérations du {{ period_start }} au {{ as_at }}.{% else %}Vous trouverez ci-joint votre relevé des montants impayés au {{ as_at }}.{% endif %}</mj-text>
        <mj-text font-size="16px" font-weight="700" padding="0 24px 12px">Montant dû : {{ amount_due }}</mj-text>
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">Des questions sur ce relevé? Répondez à ce courriel.</mj-text>{% endblock %}
{% block footer %}{{ organisation }}{% endblock %}
