{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">{% if day >= 7 %}Le paiement de votre abonnement est en retard{% else %}Nous n’avons pas pu débiter votre moyen de paiement{% endif %}</mj-text>
        <mj-text padding="0 24px 12px">Le paiement de {{ amount }} pour {{ organisation }} a échoué le {{ failed_on }}.</mj-text>
        <mj-text padding="0 24px 12px">{% if day >= 7 %}L’organisation est en lecture seule jusqu’à ce que le paiement passe : tout le monde peut consulter et exporter, personne ne peut rien modifier.{% else %}Mettez à jour le moyen de paiement d’ici le {{ grace_until }} pour continuer sans interruption. Ensuite, l’organisation passera en lecture seule — rien n’est supprimé.{% endif %}</mj-text>
        <mj-button href="{{ link }}" align="left" padding="8px 24px 16px">Mettre à jour le moyen de paiement</mj-button>
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">{{ link }}</mj-text>{% endblock %}
{% block footer %}En tant que propriétaire de {{ organisation }}, vous recevez ce courriel.{% endblock %}
