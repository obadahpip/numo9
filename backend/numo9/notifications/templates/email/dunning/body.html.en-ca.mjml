{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">{% if day >= 7 %}Your subscription payment is overdue{% else %}We couldn't charge your payment method{% endif %}</mj-text>
        <mj-text padding="0 24px 12px">The payment of {{ amount }} for {{ organisation }} failed on {{ failed_on }}.</mj-text>
        <mj-text padding="0 24px 12px">{% if day >= 7 %}The organisation is read-only until the payment goes through: everyone can still see and export, nobody can change anything.{% else %}Update the payment method by {{ grace_until }} to keep working without a break. After that the organisation becomes read-only — nothing is deleted.{% endif %}</mj-text>
        <mj-button href="{{ link }}" align="left" padding="8px 24px 16px">Update payment method</mj-button>
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">{{ link }}</mj-text>{% endblock %}
{% block footer %}As an owner of {{ organisation }}, you get this email.{% endblock %}
