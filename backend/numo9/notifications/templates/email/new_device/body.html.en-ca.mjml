{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">New sign-in on {{ device }}</mj-text>
        <mj-text padding="0 24px 12px">Your Numo9 account {{ email }} was signed in on {{ when }} from {{ device }} ({{ ip }}).</mj-text>
        <mj-text padding="0 24px 12px">If this was you, nothing to do. If not, change your password now and sign out the other sessions.</mj-text>
        <mj-button href="{{ link }}" align="left" padding="8px 24px 16px">Review my sessions</mj-button>
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">{{ link }}</mj-text>{% endblock %}
{% block footer %}You always get this email: sign-in alerts can't be turned off.{% endblock %}
