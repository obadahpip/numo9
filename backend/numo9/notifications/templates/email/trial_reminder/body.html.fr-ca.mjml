{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">{% if days_left > 0 %}L’essai de {{ organisation }} se termine le {{ ends_on }}{% else %}L’essai de {{ organisation }} est terminé{% endif %}</mj-text>
        <mj-text padding="0 24px 12px">{% if days_left > 0 %}Choisissez un forfait avant le {{ ends_on }} pour continuer sans interruption. Sinon, l’organisation passe en lecture seule après 23 h 59 ce jour-là : rien n’est supprimé, et vous pouvez encore tout consulter et exporter.{% else %}Vos livres sont en lecture seule : rien n’a été supprimé, et vous pouvez encore tout consulter et exporter. Choisissez un forfait pour faire de nouveau des modifications.{% endif %}</mj-text>
        <mj-button href="{{ link }}" align="left" padding="8px 24px 16px">Choisir un forfait</mj-button>
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">{{ link }}</mj-text>{% endblock %}
{% block footer %}En tant que propriétaire de {{ organisation }}, vous recevez ce courriel.{% endblock %}
