{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">{{ title }}</mj-text>
        {% if body %}<mj-text padding="0 24px 16px">{{ body|linebreaksbr }}</mj-text>{% endif %}
        {% if link %}<mj-button href="{{ link }}" align="left" padding="8px 24px">Ouvrir dans Numo9</mj-button>{% endif %}{% endblock %}
{% block footer %}Vous recevez ce courriel en raison de vos paramètres de notification{% if organisation %} pour {{ organisation }}{% endif %} dans Numo9. Modifiez-les sous Notifications.{% endblock %}
