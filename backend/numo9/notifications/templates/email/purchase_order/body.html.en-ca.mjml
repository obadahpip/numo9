{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">Purchase order {{ number }}</mj-text>
        <mj-text padding="0 24px 12px">{{ message|linebreaksbr }}</mj-text>
        <mj-text font-size="16px" font-weight="700" padding="0 24px 4px">Total: {{ total }}</mj-text>{% if delivery_date %}
        <mj-text padding="0 24px 12px">Delivery date: {{ delivery_date }}</mj-text>{% endif %}
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">The purchase order is attached as a PDF. Reply to this email with any questions.</mj-text>{% endblock %}
{% block footer %}{{ organisation }}{% endblock %}
