{% extends "email/base.mjml" %}
{% block content %}        <mj-text font-size="20px" line-height="28px" font-weight="700" padding="0 24px 12px">Facture {{ number }}</mj-text>
        <mj-text padding="0 24px 12px">{{ message|linebreaksbr }}</mj-text>
        <mj-text font-size="16px" font-weight="700" padding="0 24px 4px">Montant dû : {{ amount_due }}</mj-text>{% if due_date %}
        <mj-text padding="0 24px 12px">Échéance : {{ due_date }}</mj-text>{% endif %}
        <mj-button href="{{ link }}" align="left" padding="8px 24px 16px">Voir la facture</mj-button>
        <mj-text font-size="13px" color="#5C6370" padding="0 24px">La facture est jointe en PDF.</mj-text>{% endblock %}
{% block footer %}{{ organisation }}{% endblock %}
