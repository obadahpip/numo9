# Copy to .env (never commit .env). Values shown are development examples only.

# Which settings module to load: numo9.settings.{dev,test,staging,prod}
DJANGO_SETTINGS_MODULE=numo9.settings.dev

# Required in staging/prod. Dev/test fall back to an insecure development key.
DJANGO_SECRET_KEY=change-me

# "true"/"false". Read in dev only; always false in test/staging/prod.
DJANGO_DEBUG=true

# Comma-separated host names. Required in staging/prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Staging/prod only (S-03-T01). HTTPS ends at the proxy, which sets X-Forwarded-Proto.
# DJANGO_SECURE_SSL_REDIRECT=true        # default true; false only behind a proxy that redirects
# DJANGO_SECURE_HSTS_SECONDS=31536000    # default one year (preload-ready)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.numo9.ca,https://console.numo9.ca

# Logs (S-03-T06): JSON lines (default true in staging/prod, false locally) and level.
# NUMO9_LOG_JSON=false
# NUMO9_LOG_LEVEL=INFO
# Sentry error reports, staging/prod only; empty = off. Events are scrubbed before sending.
# SENTRY_DSN=

# Database URL (dj-database-url format). Required in staging/prod.
# Dev/test default to SQLite until docker-compose Postgres exists (S-01-T06).
DATABASE_URL=postgres://numo9:numo9@localhost:5432/numo9

# IANA time zone used for server-side datetimes.
DJANGO_TIME_ZONE=America/Toronto

# Authentication (A-02). Links in verification/reset emails open the web app at this address.
# NUMO9_FRONTEND_URL=http://localhost:3000
# Breached-password check (Pwned Passwords k-anonymity API); default true, false in tests.
# NUMO9_BREACHED_PASSWORD_CHECK=true

# Outgoing email (A-07 adds the provider). Dev: Mailpit from docker-compose.dev.yml on :1025.
# DJANGO_EMAIL_HOST=localhost
# DJANGO_EMAIL_PORT=1025
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=false
# DJANGO_DEFAULT_FROM_EMAIL=Numo9 <no-reply@numo9.ca>

# Audit log client IP (A-04-T04): number of trusted proxies in front of the app (Caddy: 1).
# NUMO9_TRUSTED_PROXY_COUNT=0
