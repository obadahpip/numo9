# Copy to .env (never commit .env). Values shown are development examples only.

# Which settings module to load: numo9.settings.{dev,test,staging,prod}
DJANGO_SETTINGS_MODULE=numo9.settings.dev

# Required in staging/prod. Dev/test fall back to an insecure development key.
DJANGO_SECRET_KEY=change-me

# "true"/"false". Read in dev only; always false in test/staging/prod.
DJANGO_DEBUG=true

# Comma-separated host names. Required in staging/prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (dj-database-url format). Required in staging/prod.
# Dev/test default to SQLite until docker-compose Postgres exists (S-01-T06).
DATABASE_URL=postgres://numo9:numo9@localhost:5432/numo9

# IANA time zone used for server-side datetimes.
DJANGO_TIME_ZONE=America/Toronto
