{
  "name": "numo9",
  "version": "0.0.0",
  "private": true,
  "description": "Numo9 monorepo root (pnpm workspace: frontend, mobile, packages/*)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write --ignore-unknown frontend mobile packages",
    "format:check": "prettier --check --ignore-unknown frontend mobile packages"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
